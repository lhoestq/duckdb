# name: test/sql/copy/parquet/writer/parquet_write_content_defined_pages.test
# description: Test the content_defined_chunking COPY option
# group: [writer]

require parquet

# three shapes of the same data: pages cut by size only, pages cut by content at the defaults, and pages
# cut by content with a small minimum. The data has enough distinct values that the string column is not
# dictionary-encoded, so its pages are a readable size.
statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/by_size.parquet' (format parquet, compression uncompressed);

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/by_content.parquet' (format parquet, compression uncompressed, content_defined_chunking true);

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/content_small.parquet' (format parquet, compression uncompressed, content_defined_chunking {min_chunk_size: '64KB', max_chunk_size: '128KB'});

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/content_big.parquet' (format parquet, compression uncompressed, content_defined_chunking {min_chunk_size: '1MB', max_chunk_size: '2MB'});

# false has to mean "do not touch the writer's normal page cutting", not "cut at some default size"
statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/turned_off.parquet' (format parquet, compression uncompressed, content_defined_chunking false);

query I
select hash(content) = (select hash(content) from read_blob('{TEST_DIR}/by_size.parquet'))
from read_blob('{TEST_DIR}/turned_off.parquet');
----
true

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/by_content_b.parquet' (format parquet, compression uncompressed, content_defined_chunking true);

# writing the same thing twice gives the same bytes, which is the whole premise
query I
select hash(a.content) = hash(b.content)
from read_blob('{TEST_DIR}/by_content.parquet') a, read_blob('{TEST_DIR}/by_content_b.parquet') b;
----
true

# round trip: the option moves page boundaries and nothing else
query II
select count(*), sum(i) from '{TEST_DIR}/by_content.parquet';
----
50000	1249975000

query I
select count(*) from (select * from '{TEST_DIR}/by_size.parquet' except all select * from '{TEST_DIR}/by_content.parquet');
----
0

query I
select count(*) from (select * from '{TEST_DIR}/by_content.parquet' except all select * from '{TEST_DIR}/content_small.parquet');
----
0

query I
select count(*) from (select * from '{TEST_DIR}/by_content.parquet' except all select * from '{TEST_DIR}/content_big.parquet');
----
0

# one data page per column chunk without the option, and many more with it
query I
select pages
from (select sum(s.count) pages from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/by_size.parquet') where path_in_schema = 's'));
----
1

query I
select pages > 10
from (select sum(s.count) pages from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/by_content.parquet') where path_in_schema = 's'));
----
true

# the minimum and the maximum are both honoured, on uncompressed value bytes: the mean page size of a
# column sits between them, and follows them when they move
query I
select mean between 65536 and 131072
from (select (select sum(total_uncompressed_size) from parquet_metadata('{TEST_DIR}/content_small.parquet') where path_in_schema = 's') /
           (select sum(s.count) from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/content_small.parquet') where path_in_schema = 's')) mean);
----
true

query I
select mean > 131072
from (select (select sum(total_uncompressed_size) from parquet_metadata('{TEST_DIR}/content_big.parquet') where path_in_schema = 's') /
           (select sum(s.count) from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/content_big.parquet') where path_in_schema = 's')) mean);
----
true

# fewer pages for a bigger minimum, more for a smaller one
query I
select small_pages > content_pages
from (select sum(s.count) small_pages from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/content_small.parquet') where path_in_schema = 's')),
     (select sum(s.count) content_pages from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/by_content.parquet') where path_in_schema = 's'));
----
true

# encoding_stats counts the pages of a column chunk, which makes it enough to pin a column's page count
statement ok
create macro cdc_pages(path, file) as
	(select sum(s.count) from (select unnest(encoding_stats) s from parquet_metadata(file) where path_in_schema = path) where s.page_type = 'DATA_PAGE');

# The page counts below are pinned so that a change to the gear tables, to the size gate, or to which side
# of a boundary a value lands on fails here instead of quietly moving every boundary after it. They are
# not arbitrary numbers: parquet-cpp cuts the same pages from the same data, which is what
# scripts/cdc_conformance.py of the hf extension checks (it compares per-page value counts, not just how
# many there are). Most of these are written into one row group, so that the counts do not move with the row
# group size.
statement ok
copy (select range i from range(200_000)) to '{TEST_DIR}/pin_i.parquet' (format parquet, compression uncompressed, row_group_size 10_000_000, content_defined_chunking {min_chunk_size: 65536, max_chunk_size: 131072});

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/pin_s.parquet' (format parquet, compression uncompressed, row_group_size 10_000_000, content_defined_chunking {min_chunk_size: 65536, max_chunk_size: 131072});

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/pin_s_norm2.parquet' (format parquet, compression uncompressed, row_group_size 10_000_000, content_defined_chunking {min_chunk_size: 65536, max_chunk_size: 131072, norm_level: 2});

statement ok
copy (select range i, case when range % 977 = 0 then null else repeat(md5(range::varchar), 4) end s from range(50_000)) to '{TEST_DIR}/pin_s_null.parquet' (format parquet, compression uncompressed, row_group_size 10_000_000, content_defined_chunking {min_chunk_size: 65536, max_chunk_size: 131072});

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/pin_s_no_floor.parquet' (format parquet, compression uncompressed, row_group_size 10_000_000, content_defined_chunking {min_chunk_size: 0, max_chunk_size: 65536});

# a bare number is a byte count, which is the form to use when comparing against another writer: '64KB'
# would mean 64000 here and 65536 anywhere else, and a size that moves by 2% moves every boundary after
# the first page
query II
select cdc_pages('i', '{TEST_DIR}/pin_i.parquet'), cdc_pages('s', '{TEST_DIR}/pin_s.parquet');
----
22	61

# a looser mask cuts more, smaller pages: norm_level takes bits off the mask, so boundaries come up sooner
query I
select cdc_pages('s', '{TEST_DIR}/pin_s_norm2.parquet');
----
84

# a null is hashed too (it is a definition level, and Arrow hashes those), so nulls move boundaries. They
# do not move the count of pages much - a page that stops early starts again early - so this is a check
# that the column is still being cut at all, at the same average, with levels in the feed.
query I
select cdc_pages('s', '{TEST_DIR}/pin_s_null.parquet');
----
61

# no minimum at all: the hash runs from the first byte of every page, which is 156 pages instead of 61
query I
select cdc_pages('s', '{TEST_DIR}/pin_s_no_floor.parquet');
----
156

# data_page_size_limit cuts on top of the content boundaries without moving them, like Arrow's data_pagesize:
# even below min_chunk_size, the content cuts are kept in addition to the size cuts
statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/pin_s_size_limited.parquet' (format parquet, compression uncompressed, row_group_size 10_000_000, data_page_size_limit 40000, content_defined_chunking {min_chunk_size: 65536, max_chunk_size: 131072});

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/size_limited.parquet' (format parquet, compression uncompressed, row_group_size 10_000_000, data_page_size_limit 40000);

query II
select cdc_pages('s', '{TEST_DIR}/pin_s_size_limited.parquet'), cdc_pages('s', '{TEST_DIR}/size_limited.parquet');
----
193	165

# the chunker state carries over from one row group to the next, as in Arrow: row group boundaries add page
# boundaries without moving the content ones, so this is the 61 pages above plus one per extra row group
# (a fresh chunker per row group would give 64)
statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/pin_s_row_groups.parquet' (format parquet, compression uncompressed, row_group_size 10_000, content_defined_chunking {min_chunk_size: 65536, max_chunk_size: 131072});

query II
select count(*), cdc_pages('s', '{TEST_DIR}/pin_s_row_groups.parquet')
from parquet_metadata('{TEST_DIR}/pin_s_row_groups.parquet') where path_in_schema = 's';
----
5	65

# a column under a list keeps size-based page cuts: its values are interleaved with the parent's levels,
# and a page there can only be cut at a record boundary
statement ok
copy (select range i, [repeat(md5(range::varchar), 4)] l from range(50_000)) to '{TEST_DIR}/nested_list.parquet' (format parquet, compression uncompressed, content_defined_chunking true);

query I
select sum(s.count) pages
from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/nested_list.parquet') where path_in_schema = 'l, list, element')
where s.page_type = 'DATA_PAGE';
----
1

# nulls, empty and single-row files round trip
statement ok
copy (select range i, case when range % 7 = 0 then null else repeat(md5(range::varchar), 4) end s from range(50_000)) to '{TEST_DIR}/with_nulls.parquet' (format parquet, content_defined_chunking {min_chunk_size: '32KB'});

query II
select count(*), count(*) - count(s) from '{TEST_DIR}/with_nulls.parquet';
----
50000	7143

query I
select count(*) from (
	select * from '{TEST_DIR}/with_nulls.parquet'
	except all
	select range i, case when range % 7 = 0 then null else repeat(md5(range::varchar), 4) end s from range(50_000));
----
0

statement ok
copy (select 1 i where false) to '{TEST_DIR}/empty_cdc.parquet' (format parquet, content_defined_chunking true);

query I
select count(*) from '{TEST_DIR}/empty_cdc.parquet';
----
0

statement ok
copy (select repeat('x', 4_000_000) s) to '{TEST_DIR}/oversized_value.parquet' (format parquet, content_defined_chunking {min_chunk_size: '1KB', max_chunk_size: '64KB'});

query I
select length(s) = 4000000 from '{TEST_DIR}/oversized_value.parquet';
----
true

# a value bigger than the page size still lands on a page of its own, and pages stay under the 100MB
# ceiling
query I
select sum(s.count) = 1
from (select unnest(encoding_stats) s from parquet_metadata('{TEST_DIR}/oversized_value.parquet'))
where s.page_type = 'DATA_PAGE';
----
true

# the option survives being serialized, i.e. a prepared COPY writes what was prepared
statement ok
prepare cdc_copy as copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/prepared.parquet' (format parquet, compression uncompressed, content_defined_chunking {min_chunk_size: '64KB', max_chunk_size: '128KB'});

statement ok
execute cdc_copy;

query I
select hash(content) = (select hash(content) from read_blob('{TEST_DIR}/content_small.parquet'))
from read_blob('{TEST_DIR}/prepared.parquet');
----
true

# the option is write-only: reading a file does not take it
statement error
select count(*) from read_parquet('{TEST_DIR}/by_content.parquet', content_defined_chunking := true);
----
Invalid named parameter

statement error
copy (select 42 i) to '{TEST_DIR}/bad_field.parquet' (format parquet, content_defined_chunking {bogus: 1});
----
unknown field

statement error
copy (select 42 i) to '{TEST_DIR}/min_over_max.parquet' (format parquet, content_defined_chunking {min_chunk_size: '5MB', max_chunk_size: '1MB'});
----
must be greater than

statement error
copy (select 42 i) to '{TEST_DIR}/max_too_small.parquet' (format parquet, content_defined_chunking {max_chunk_size: 0});
----
at least 1 byte

# a minimum equal to the maximum is refused like in Arrow, even when a negative norm_level would leave a usable mask
statement error
copy (select 42 i) to '{TEST_DIR}/equal_sizes.parquet' (format parquet, content_defined_chunking {min_chunk_size: 100, max_chunk_size: 100});
----
must be greater than

statement error
copy (select 42 i) to '{TEST_DIR}/equal_sizes_norm.parquet' (format parquet, content_defined_chunking {min_chunk_size: 100, max_chunk_size: 100, norm_level: -1});
----
must be greater than

statement error
copy (select 42 i) to '{TEST_DIR}/far_norm.parquet' (format parquet, content_defined_chunking {min_chunk_size: '1MB', max_chunk_size: '2MB', norm_level: 40});
----
must be between 1 and 63

# norm_level is a 32-bit integer, as in Arrow
statement error
copy (select 42 i) to '{TEST_DIR}/huge_norm.parquet' (format parquet, content_defined_chunking {norm_level: -9223372036854775807});
----
out of range

statement error
copy (select 42 i) to '{TEST_DIR}/not_a_size.parquet' (format parquet, content_defined_chunking {min_chunk_size: 'nonsense'});
----
is not a size

statement error
copy (select 42 i) to '{TEST_DIR}/oversized_chunk.parquet' (format parquet, content_defined_chunking {max_chunk_size: '1GB'});
----
cannot exceed

statement error
copy (select 42 i) to '{TEST_DIR}/null_chunk.parquet' (format parquet, content_defined_chunking {min_chunk_size: null});
----
cannot be NULL

# content-defined chunking forces the copy ordered, session setting aside: with
# preserve_insertion_order off, the same query written twice still gives the same bytes, because the
# writer sees the row groups in file order either way. Without the forcing this writes through the
# parallel unordered path, where the boundaries depend on which thread flushed first
statement ok
SET preserve_insertion_order=false;

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/unordered_a.parquet' (format parquet, compression uncompressed, content_defined_chunking true);

statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(50_000)) to '{TEST_DIR}/unordered_b.parquet' (format parquet, compression uncompressed, content_defined_chunking true);

query I
select hash(a.content) = hash(b.content)
from read_blob('{TEST_DIR}/unordered_a.parquet') a, read_blob('{TEST_DIR}/unordered_b.parquet') b;
----
true

# ... and the same bytes as the ordered write of the same query from the top of this file
query I
select hash(content) = (select hash(content) from read_blob('{TEST_DIR}/by_content.parquet'))
from read_blob('{TEST_DIR}/unordered_a.parquet');
----
true

# the row groups come out in input order, which the unordered parallel path cannot promise: with it
# the per-row-group minimum of i is whatever row group happened to flush first
statement ok
copy (select range i from range(3_000_000)) to '{TEST_DIR}/unordered_order.parquet' (format parquet, content_defined_chunking true);

query I
select count(*)
from (select stats_min_value::bigint m, lag(stats_min_value::bigint) over (order by row_group_id) prev
      from parquet_metadata('{TEST_DIR}/unordered_order.parquet') where path_in_schema = 'i')
where prev is not null and m < prev;
----
0

# a query with no insertion order to begin with (hash aggregate) still gets a single writer feeding
# the chunker: the round trip holds and the pages are still cut by content
statement ok
copy (select range % 200_000 g, count(*) c, sum(range) t from range(1_000_000) group by g) to '{TEST_DIR}/cdc_agg.parquet' (format parquet, compression uncompressed, content_defined_chunking {min_chunk_size: '64KB'});

query I
select count(*) from (
	select * from '{TEST_DIR}/cdc_agg.parquet'
	except all
	select range % 200_000 g, count(*) c, sum(range) t from range(1_000_000) group by g);
----
0

query I
select cdc_pages('t', '{TEST_DIR}/cdc_agg.parquet') > 1;
----
true

statement ok
RESET preserve_insertion_order;

# per-thread output and hive partitioning put rows into files and row groups by arrival, which no
# amount of ordering at the writer can make reproducible, so CDC refuses them up front
statement error
copy (select range i from range(100)) to '{TEST_DIR}/cdc_per_thread.parquet' (format parquet, content_defined_chunking true, per_thread_output true);
----
cannot be combined

statement error
copy (select range i, range % 10 p from range(100)) to '{TEST_DIR}/cdc_partitioned.parquet' (format parquet, content_defined_chunking true, partition_by p);
----
cannot be combined

# file rotation is not a problem: with the rotation decision taken where the writes are ordered, CDC
# just writes one file at a time, and every file round trips
statement ok
copy (select range i, repeat(md5(range::varchar), 4) s from range(500_000)) to '{TEST_DIR}/cdc_rot' (format parquet, content_defined_chunking {min_chunk_size: '32KB'}, file_size_bytes 2_000_000);

query I
select count(*) > 1 from glob('{TEST_DIR}/cdc_rot/*.parquet');
----
true

query I
select count(*) from (
	select * from '{TEST_DIR}/cdc_rot/*.parquet'
	except all
	select range i, repeat(md5(range::varchar), 4) s from range(500_000));
----
0

# dictionary-encoded columns are cut by content too: a low-cardinality string column stays dictionary
# encoded, and its index pages are pages like any other
statement ok
copy (select range i, case range % 5 when 0 then 'alpha' when 1 then 'beta' when 2 then 'gamma' when 3 then 'delta' else 'epsilon' end s from range(500_000)) to '{TEST_DIR}/dict_nocdc.parquet' (format parquet, compression uncompressed);

statement ok
copy (select range i, case range % 5 when 0 then 'alpha' when 1 then 'beta' when 2 then 'gamma' when 3 then 'delta' else 'epsilon' end s from range(500_000)) to '{TEST_DIR}/dict_cdc.parquet' (format parquet, compression uncompressed, content_defined_chunking {min_chunk_size: 16384, max_chunk_size: 32768});

query I
select cdc_pages('s', '{TEST_DIR}/dict_cdc.parquet') > 10 and cdc_pages('s', '{TEST_DIR}/dict_cdc.parquet') > cdc_pages('s', '{TEST_DIR}/dict_nocdc.parquet') * 5;
----
true

query I
select count(*) from (
	select * from '{TEST_DIR}/dict_cdc.parquet'
	except all
	select range i, case range % 5 when 0 then 'alpha' when 1 then 'beta' when 2 then 'gamma' when 3 then 'delta' else 'epsilon' end s from range(500_000));
----
0

# the fixed-width types CDC hashes all cut pages and round trip: boolean as a bitstream, the
# timestamps each as their own int64 unit
statement ok
copy (select range i, range % 2 = 0 b, make_timestamp(range) t, make_timestamp_ns(range) tn, cast(make_timestamp(range) as timestamptz) ttz from range(2_000_000)) to '{TEST_DIR}/cdc_types.parquet' (format parquet, compression uncompressed, content_defined_chunking {min_chunk_size: '64KB'});

query I
select cdc_pages('b', '{TEST_DIR}/cdc_types.parquet') > 1 and cdc_pages('t', '{TEST_DIR}/cdc_types.parquet') > 1 and cdc_pages('tn', '{TEST_DIR}/cdc_types.parquet') > 1 and cdc_pages('ttz', '{TEST_DIR}/cdc_types.parquet') > 1;
----
true

query I
select count(*) from (
	select * from '{TEST_DIR}/cdc_types.parquet'
	except all
	select range i, range % 2 = 0 b, make_timestamp(range) t, make_timestamp_ns(range) tn, cast(make_timestamp(range) as timestamptz) ttz from range(2_000_000));
----
0
